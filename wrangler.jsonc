{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chargenear",
  "main": "worker.js",
  "compatibility_date": "2026-04-17",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chargenear",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "dev": {
    "port": 8000,
    "host": "localhost"
  },
  "routes": [
    { "pattern": "chargenear.org", "custom_domain": true },
    { "pattern": "www.chargenear.org", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Run the Worker for every request so HTTPS/www redirects and security headers apply to pages too.
    "run_worker_first": true,
    "not_found_handling": "404-page"
  }
  // Secrets MAPBOX_TOKEN and OCM_API_KEY: set them with `npx wrangler secret put NAME`
  // or in the Cloudflare dashboard (Worker > Settings > Variables and Secrets). Locally, use .dev.vars.
}
