{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chargenear",
  "main": "worker.js",
  "compatibility_date": "2026-04-17",
  "keep_vars": true,
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8000
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
  // Secrets MAPBOX_TOKEN and OCM_API_KEY: set them with `npx wrangler secret put NAME`
  // or in the Cloudflare dashboard (Worker > Settings > Variables and Secrets). Locally, use .dev.vars.
}
