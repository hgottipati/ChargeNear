{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chargenear",
  "main": "worker.js",
  "compatibility_date": "2026-04-17",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
  // MAPBOX_TOKEN is a secret: set it in the Cloudflare dashboard (Worker > Settings > Variables and Secrets)
  // or with `npx wrangler secret put MAPBOX_TOKEN`. For local `wrangler dev`, put it in .dev.vars.
}
